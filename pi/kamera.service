# Live-Bild der Kamera und Autofokus als Dienst: Webseite auf Port 8080
# (pi/kamera.py, pi/autofokus.py, docs/autofokus.md). Die Kamera laeuft nur,
# solange jemand zusieht. Vorlage fuer pi/einrichten.sh, das die @...@
# ersetzt.
[Unit]
Description=Kamera-Livebild und Autofokus (Engraver)
After=network-online.target
Wants=network-online.target

[Service]
User=@BENUTZER@
ExecStart=/usr/bin/python3 /usr/local/lib/engraver/kamera.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
